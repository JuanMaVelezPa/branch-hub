# Host port for the SPA (Nginx `web` service); default 8080
WEB_PORT=8080
# Host port for the API (Spring `app` service: REST, Swagger, Actuator); default 8081
API_PORT=8081

ALERTMANAGER_CONFIG_FILE=./monitoring/alertmanager/alertmanager.local.yml
DISCORD_WEBHOOK_FILE=./monitoring/alertmanager/discord-webhook-url

# App security (local)
APP_SUPER_ADMIN_EMAIL=admin@example.com
APP_SUPER_ADMIN_PASSWORD=Admin_ChangeMe_2026!
JWT_SECRET=ChangeMe_LocalVeryLongRandomJwtSecret_AtLeast_32_Chars
JWT_EXPIRATION_SECONDS=3600
APP_SECURITY_ACTUATOR_PUBLIC=true

# Database (local)
POSTGRES_DB=branchhub
POSTGRES_USER=branchhub
POSTGRES_PASSWORD=branchhub
DB_URL=jdbc:postgresql://postgres:5432/branchhub
DB_USERNAME=branchhub
DB_PASSWORD=branchhub

# Kafka (local)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Grafana (local)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ChangeMe_LocalGrafanaPassword
