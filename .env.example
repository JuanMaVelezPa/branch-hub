ALERTMANAGER_CONFIG_FILE=./monitoring/alertmanager/alertmanager.local.yml
DISCORD_WEBHOOK_FILE=./monitoring/alertmanager/discord-webhook-url

# App security (local)
APP_SUPER_ADMIN_EMAIL=admin@example.com
APP_SUPER_ADMIN_PASSWORD=Admin_ChangeMe_2026!
JWT_SECRET=ChangeMe_LocalVeryLongRandomJwtSecret_AtLeast_32_Chars
JWT_EXPIRATION_SECONDS=3600
APP_SECURITY_ACTUATOR_PUBLIC=true

# Database (local)
POSTGRES_DB=companydb
POSTGRES_USER=company
POSTGRES_PASSWORD=company
DB_URL=jdbc:postgresql://postgres:5432/companydb
DB_USERNAME=company
DB_PASSWORD=company

# Kafka (local)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# MFA TOTP for SUPER_ADMIN / APP_ADMIN (32-byte AES key, Base64 — required for enroll/verify)
# IAM_MFA_ENCRYPTION_KEY=
# Optional issuer shown in authenticator apps (defaults to spring.application.name)
# IAM_MFA_ISSUER=spring-web

# IAM email outbox (optional; use Mailpit locally or Gmail app password in dev)
# IAM_EMAIL_ENABLED=false
# IAM_EMAIL_FROM=noreply@yourdomain
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=you@gmail.com
# SPRING_MAIL_PASSWORD=your-app-password

# Grafana (local)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ChangeMe_LocalGrafanaPassword
