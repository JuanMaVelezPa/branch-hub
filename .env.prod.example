# Use this file as a base for production-like runs.
# Do not commit real production secrets.
# Rotate all values before each real deployment.

# Plain `docker compose ...` on the server always uses the prod overlay
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Host ports: all bound to 127.0.0.1, in the Branch Hub block 18090-18099.
# The compose file already defaults to these values; uncomment only to override.
# WEB_PORT=18090           # SPA (nginx `web`)
# API_PORT=18091           # API (Spring `app`: REST, Swagger, Actuator)
# GRAFANA_PORT=18092       # Grafana
# PROMETHEUS_PORT=18093    # Prometheus
# ALERTMANAGER_PORT=18094  # Alertmanager
# POSTGRES_PORT=18095      # PostgreSQL

# Alertmanager reads the real Discord webhook from this gitignored file
ALERTMANAGER_CONFIG_FILE=./monitoring/alertmanager/alertmanager.yml
DISCORD_WEBHOOK_FILE=./monitoring/alertmanager/discord-webhook-url

# App security
APP_SUPER_ADMIN_EMAIL=admin@example.com
APP_SUPER_ADMIN_PASSWORD=ChangeMe_StrongPassword_Prod
JWT_SECRET=ChangeMe_VeryLongRandomJwtSecret_AtLeast_32_Chars
JWT_EXPIRATION_SECONDS=3600
# The prod overlay forces APP_SECURITY_ACTUATOR_PUBLIC=true (private network only; nginx serves just /actuator/health)
SECURITY_COOKIES_SECURE=true

# Database
POSTGRES_DB=branchhub
POSTGRES_USER=branchhub
POSTGRES_PASSWORD=ChangeMe_DbPassword_Prod
DB_URL=jdbc:postgresql://postgres:5432/branchhub
DB_USERNAME=branchhub
DB_PASSWORD=ChangeMe_DbPassword_Prod

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ChangeMe_GrafanaPassword_Prod
GRAFANA_PUBLIC_URL=https://code-branchhub-grafana.jotaeme.dev
