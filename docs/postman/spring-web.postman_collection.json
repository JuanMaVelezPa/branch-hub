{
  "info": {
    "_postman_id": "fbe28f84-175e-4402-a934-3d94f443f6e1",
    "name": "spring-web API",
    "description": "End-to-end collection for auth (JWT + refresh cookie, optional MFA TOTP for SUPER_ADMIN/APP_ADMIN), refresh **sessions** (list / revoke / revoke-others), branches, and observability. After login, either `token` or `mfaChallengeToken` is set; use MFA verify + `mfaCode` when applicable. For **1.09**, send the refresh cookie (`REFRESH_TOKEN` by default): Postman cookie jar after login, or `Cookie: REFRESH_TOKEN={{refreshCookieValue}}`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('baseUrl')) {",
          "  pm.collectionVariables.set('baseUrl', 'http://localhost:8081');",
          "}",
          "if (!pm.collectionVariables.get('superAdminEmail')) {",
          "  pm.collectionVariables.set('superAdminEmail', 'admin@example.com');",
          "}",
          "if (!pm.collectionVariables.get('superAdminPassword')) {",
          "  pm.collectionVariables.set('superAdminPassword', 'Admin_ChangeMe_2026!');",
          "}",
          "if (!pm.collectionVariables.get('branchCode')) {",
          "  pm.collectionVariables.set('branchCode', 'BR100');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "if (json.mfaChallengeToken) {",
              "  pm.collectionVariables.set('mfaChallengeToken', json.mfaChallengeToken);",
              "  pm.test('MFA challenge returned', function () {",
              "    pm.expect(json.mfaChallengeToken).to.be.a('string');",
              "  });",
              "} else if (json.token) {",
              "  pm.collectionVariables.set('token', json.token);",
              "  pm.test('Access token present', function () {",
              "    pm.expect(json.token).to.be.a('string');",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "1.01 Auth - Refresh (cookie)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "refresh"]
        },
        "description": "Send the HttpOnly refresh cookie from login/MFA verify. Returns new access token and rotated cookie."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "if (json.token) { pm.collectionVariables.set('token', json.token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "1.02 Auth - Logout",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "logout"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 204', function () { pm.response.to.have.status(204); });"]
          }
        }
      ]
    },
    {
      "name": "1.03 Auth - MFA verify (after mfaChallengeToken)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mfaChallengeToken\": \"{{mfaChallengeToken}}\",\n  \"code\": \"{{mfaCode}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/mfa/verify",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "mfa", "verify"]
        },
        "description": "Set collection variable `mfaCode` to the current 6-digit TOTP. Uses `mfaChallengeToken` from login."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "if (json.token) { pm.collectionVariables.set('token', json.token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "1.04 Auth - MFA enroll begin (SUPER_ADMIN / APP_ADMIN)",
      "request": {
        "method": "POST",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/mfa/enroll/begin",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "mfa", "enroll", "begin"]
        },
        "description": "Requires `IAM_MFA_ENCRYPTION_KEY` on the server. Returns otpauth URI and Base32 secret."
      }
    },
    {
      "name": "1.05 Auth - MFA enroll confirm",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{mfaCode}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/mfa/enroll/confirm",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "mfa", "enroll", "confirm"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 204', function () { pm.response.to.have.status(204); });"]
          }
        }
      ]
    },
    {
      "name": "1.06 Me - Current profile (authenticated)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Has email and roles', function () {",
              "  pm.expect(json.email).to.exist;",
              "  pm.expect(json.roles).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "1.07 Auth - List refresh sessions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "sessions"
          ]
        },
        "description": "Requires Bearer token. To mark which row is **current**, add header `Cookie: REFRESH_TOKEN=<value>` (same as `refreshCookieValue` in **1.09**), or rely on Postman's cookie jar after login."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Array of sessions', function () {",
              "  pm.expect(body).to.be.an('array');",
              "});",
              "if (Array.isArray(body) && body.length && body[0].id) {",
              "  pm.collectionVariables.set('sessionId', body[0].id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "1.08 Auth - Revoke refresh session",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/sessions/{{sessionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "sessions",
            "{{sessionId}}"
          ]
        },
        "description": "Run **1.07** first to set `sessionId`, or paste a UUID from the list response."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 204', function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "1.09 Auth - Revoke other refresh sessions",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Cookie",
            "value": "REFRESH_TOKEN={{refreshCookieValue}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/sessions/revoke-others",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "sessions",
            "revoke-others"
          ]
        },
        "description": "Keeps the session tied to this refresh cookie; revokes all other sessions for the user. Set `refreshCookieValue` to the raw refresh token (e.g. from browser devtools or Postman cookie jar after login)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Has revokedCount', function () {",
              "  pm.expect(json.revokedCount).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    },
