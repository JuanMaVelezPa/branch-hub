{
  "name": "branch-hub-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/patch-index-html.mjs",
    "watch": "ng build --watch --configuration development",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts --project=chromium",
    "test:e2e:admin-smoke": "playwright test e2e/admin.smoke.spec.ts --project=chromium",
    "test:e2e:screenshots": "playwright test e2e/screenshots.spec.ts --project=chromium --retries=0"
  },
  "private": true,
  "packageManager": "npm@11.11.1",
  "dependencies": {
    "@angular/common": "^21.2.8",
    "@angular/compiler": "^21.2.8",
    "@angular/core": "^21.2.8",
    "@angular/forms": "^21.2.8",
    "@angular/platform-browser": "^21.2.8",
    "@angular/router": "^21.2.8",
    "@fontsource-variable/overpass": "^5.3.0",
    "@tanstack/angular-query-experimental": "^5.99.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.8",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.2.2",
    "daisyui": "^5.5.19",
    "jsdom": "^29.0.2",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.5.9",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.2",
    "vitest": "^4.1.4"
  }
}
